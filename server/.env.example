# ---------------------------------------------------------------------------
# St. Agnes Academy Alumni Management System - server configuration template
#
# Copy this file to "server/.env" and fill in your values:
#     Windows:  copy server\.env.example server\.env
#     Bash:     cp server/.env.example server/.env
#
# server/.env is gitignored and is NEVER committed or sent to the frontend,
# so the API key stays on the server only (per the manuscript's cybersecurity
# requirement that credentials must not be exposed in public source code).
# ---------------------------------------------------------------------------

# --- OpenAI API (AI Chat Support, content generation, Gmail Auto-Reply) -----
# Leave empty to run the system's built-in fallback engine (no external calls).
OPENAI_API_KEY=

# Optional: override the chat model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: request timeout in milliseconds (default: 20000)
OPENAI_TIMEOUT_MS=20000

# --- Supabase (existing project; never commit real keys) --------------------
# Use the anon public key in SUPABASE_ANON_KEY.
# The service role key is backend-only. Never put it in frontend code.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Server -----------------------------------------------------------------
# Optional: change the HTTP port (default: 3000)
# PORT=3000

# Comma-separated frontend origins for production (Vercel). Use * only in local dev.
# CORS_ORIGINS=https://your-app.vercel.app

# Set true only if you explicitly want to keep previously seeded demo records.
# KEEP_DEMO_DATA=false

# --- PayMongo (GCash checkout). Never put these keys in frontend files. -----
# Use sk_test_ / pk_test_ for sandbox. Use sk_live_ / pk_live_ only after
# PayMongo activates the live merchant account.
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_API_BASE=https://api.paymongo.com

# Public site URL used for GCash success/cancel return links.
# Example local: http://localhost:3000
# Example production: https://your-domain.example
APP_PUBLIC_URL=

# Optional SMTP for real outgoing email. Leave empty to record "not_configured"
# instead of pretending the email was sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional SMS. Leave empty to show "SMS provider is not configured."
# Semaphore (Philippines) or Twilio.
SEMAPHORE_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=